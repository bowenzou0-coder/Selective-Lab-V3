# ==============================================================================
# Selective Lab — Optional Local Development & Emulator Template
# ==============================================================================
# Only needed if developing locally outside Google AI Studio / Cloud Run.
# Copy to .env when using local Firebase emulators or isolated dev mode.

SESSION_SECRET="local-dev-session-secret-not-for-prod"
GEMINI_API_KEY=""
BOOTSTRAPPED_ADMIN_EMAIL="bowenzou0@gmail.com"

# Local Firebase Emulators (`npm run emulators`)
FIRESTORE_EMULATOR_HOST="127.0.0.1:8080"
FIREBASE_AUTH_EMULATOR_HOST="127.0.0.1:9099"
FIREBASE_STORAGE_EMULATOR_HOST="127.0.0.1:9199"
VITE_FIREBASE_AUTH_EMULATOR_HOST="127.0.0.1:9099"
VITE_FIRESTORE_EMULATOR_HOST="127.0.0.1:8080"

# Local dev PIN/password shortcut (NEVER set in production)
ALLOW_LOCAL_DEV_PIN="true"
STUDENT_PIN="1234"
ADMIN_PASSWORD="admin-dev"

# Isolated disposable in-memory mode (ONLY without emulators / CI smoke checks)
ALLOW_DEMO_MEMORY_DB="false"
