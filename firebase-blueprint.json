{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Server-managed account profile for a Selective Lab learner or admin without PII.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "maxLength": 120 },
        "role": { "type": "string", "enum": ["student", "admin"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "role", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Isolated PII document storing verified user email.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "createdAt", "updatedAt"]
    },
    "AdminMarker": {
      "title": "AdminMarker",
      "description": "Trusted admin allowlist document keyed by Firebase UID.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "createdAt"]
    },
    "StudySession": {
      "title": "StudySession",
      "description": "Locked or completed practice/mock exam session with optimistic checkpointRevision and immutable submissionSummary.",
      "type": "object",
      "properties": {
        "sessionId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "studentId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "configVersionId": { "type": "string", "maxLength": 128 },
        "mode": { "type": "string", "enum": ["daily_adaptive", "spaced_review", "section_drill", "writing_sprint", "benchmark_exam", "admin_calibration"] },
        "title": { "type": "string", "maxLength": 200 },
        "sectionFilter": { "type": "string", "maxLength": 16 },
        "mockBatch": { "type": "string", "maxLength": 16 },
        "timeMultiplier": { "type": "number" },
        "isSandbox": { "type": "boolean" },
        "status": { "type": "string", "enum": ["in_progress", "submitted"] },
        "plannedQuestionIds": { "type": "array" },
        "checkpoint": { "type": "object" },
        "checkpointRevision": { "type": "integer" },
        "submissionSummary": { "type": "object" },
        "timeLimitSec": { "type": "integer" },
        "totalSlots": { "type": "integer" },
        "correctSlots": { "type": "integer" },
        "startedAt": { "type": "string", "maxLength": 64 },
        "completedAt": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "sessionId",
        "userId",
        "studentId",
        "configVersionId",
        "mode",
        "isSandbox",
        "status",
        "plannedQuestionIds",
        "checkpoint",
        "totalSlots",
        "correctSlots",
        "startedAt"
      ]
    },
    "SessionSnapshot": {
      "title": "SessionSnapshot",
      "description": "Immutable question and stimulus snapshot frozen when a session starts (server-only access).",
      "type": "object",
      "properties": {
        "questionId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "snapshotIndex": { "type": "integer" },
        "evidenceRevision": { "type": "string", "maxLength": 128 },
        "question": { "type": "object" },
        "stimulus": { "type": "object" }
      },
      "required": ["questionId", "snapshotIndex", "evidenceRevision", "question"]
    },
    "PartAttempt": {
      "title": "PartAttempt",
      "description": "Immutable server-graded per-question-part attempt record with questionVersion and evidenceRevision.",
      "type": "object",
      "properties": {
        "attemptId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "sessionId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "questionId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "questionFamilyId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "questionVersion": { "type": "integer" },
        "evidenceRevision": { "type": "string", "maxLength": 128 },
        "partId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "skillId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "difficultyAtAttempt": { "type": "number" },
        "selectedAnswer": { "type": "string", "maxLength": 16 },
        "isCorrect": { "type": "boolean" },
        "timeSpentSec": { "type": "number" },
        "isSpacedReview": { "type": "boolean" },
        "isLegacy": { "type": "boolean" },
        "assisted": { "type": "boolean" },
        "createdAtIso": { "type": "string", "maxLength": 64 }
      },
      "required": [
        "attemptId",
        "userId",
        "sessionId",
        "questionId",
        "questionFamilyId",
        "partId",
        "skillId",
        "difficultyAtAttempt",
        "isCorrect",
        "timeSpentSec",
        "isSpacedReview"
      ]
    },
    "QuestionEvidence": {
      "title": "QuestionEvidence",
      "description": "Per-question-revision timed mastery certification record (unseen -> correct_once -> awaiting_review -> retained / needs_repair).",
      "type": "object",
      "properties": {
        "evidenceKey": { "type": "string", "minLength": 1, "maxLength": 200 },
        "questionFamilyId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "questionId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "evidenceRevision": { "type": "string", "maxLength": 128 },
        "section": { "type": "string", "enum": ["READ", "MATH", "THINK", "WRIT"] },
        "status": { "type": "string", "enum": ["unseen", "correct_once", "awaiting_review", "retained", "needs_repair"] },
        "cleanPassesCount": { "type": "integer" },
        "passTimestampsIso": { "type": "array" },
        "everCleanPassed": { "type": "boolean" },
        "firstSubmissionCleanPass": { "type": "boolean" },
        "attemptsCount": { "type": "integer" },
        "resetCount": { "type": "integer" },
        "policyVersion": { "type": "string" },
        "updatedAtIso": { "type": "string" }
      },
      "required": ["evidenceKey", "questionFamilyId", "evidenceRevision", "status", "cleanPassesCount"]
    },
    "UserSkillState": {
      "title": "UserSkillState",
      "description": "EWMA and SM-2 scheduling telemetry for one skill belonging to a learner.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "skillId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "masteryScore": { "type": "number" },
        "attemptsCount": { "type": "integer" },
        "reviewIntervalDays": { "type": "number" },
        "easeFactor": { "type": "number" },
        "plateauStatus": { "type": "string", "enum": ["none", "watch", "detected"] }
      },
      "required": ["userId", "skillId", "masteryScore", "attemptsCount", "reviewIntervalDays", "easeFactor", "plateauStatus"]
    },
    "QuestionMemoryEntry": {
      "title": "QuestionMemoryEntry",
      "description": "Per-question-family spaced repetition state updated once per question encounter.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "questionFamilyId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "lastSeenAt": { "type": "string" },
        "nextDueAt": { "type": "string" },
        "intervalDays": { "type": "number" },
        "lapseCount": { "type": "integer" }
      },
      "required": ["userId", "questionFamilyId", "lastSeenAt", "nextDueAt", "intervalDays", "lapseCount"]
    },
    "WritingSubmission": {
      "title": "WritingSubmission",
      "description": "Typed writing submission and rubric evaluation history.",
      "type": "object",
      "properties": {
        "submissionId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "sessionId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "questionId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "responseText": { "type": "string", "maxLength": 30000 },
        "wordCount": { "type": "integer" },
        "evaluations": { "type": "array" },
        "submittedAt": { "type": "string" }
      },
      "required": ["submissionId", "userId", "sessionId", "questionId", "responseText", "submittedAt"]
    },
    "AdminConfigVersion": {
      "title": "AdminConfigVersion",
      "description": "Immutable LearningConfig version managed by admin.",
      "type": "object",
      "properties": {
        "configVersionId": { "type": "string" },
        "versionNumber": { "type": "integer" },
        "notes": { "type": "string" },
        "config": { "type": "object" },
        "createdAtIso": { "type": "string" }
      },
      "required": ["configVersionId", "versionNumber", "config", "createdAtIso"]
    },
    "BankStimulus": {
      "title": "BankStimulus",
      "description": "Server-managed passage/stimulus group for question bank items.",
      "type": "object",
      "properties": {
        "stimulusId": { "type": "string" },
        "stimulusFamilyId": { "type": "string" },
        "version": { "type": "integer" },
        "section": { "type": "string", "enum": ["READ", "MATH", "THINK", "WRIT"] },
        "payload": { "type": "object" }
      },
      "required": ["stimulusId", "stimulusFamilyId", "version", "section", "payload"]
    },
    "BankQuestion": {
      "title": "BankQuestion",
      "description": "Server-only full question definition (including answer keys and evidenceRefs).",
      "type": "object",
      "properties": {
        "questionId": { "type": "string" },
        "questionFamilyId": { "type": "string" },
        "version": { "type": "integer" },
        "section": { "type": "string", "enum": ["READ", "MATH", "THINK", "WRIT"] },
        "formatType": { "type": "string" },
        "poolType": { "type": "string" },
        "qcStatus": { "type": "string", "enum": ["draft", "verified", "active", "quarantined", "retired"] },
        "payload": { "type": "object" }
      },
      "required": ["questionId", "questionFamilyId", "version", "section", "formatType", "poolType", "qcStatus", "payload"]
    },
    "ImportBatch": {
      "title": "ImportBatch",
      "description": "Audit record of an imported manifest batch with provenance.",
      "type": "object",
      "properties": {
        "batchId": { "type": "string" },
        "batchLabel": { "type": "string" },
        "createdAtIso": { "type": "string" },
        "importedBy": { "type": "string" },
        "questionsCount": { "type": "integer" }
      },
      "required": ["batchId", "batchLabel", "createdAtIso", "importedBy"]
    },
    "MediaAsset": {
      "title": "MediaAsset",
      "description": "Content-addressed media metadata stored in Cloud Storage.",
      "type": "object",
      "properties": {
        "assetId": { "type": "string" },
        "objectKey": { "type": "string" },
        "url": { "type": "string" },
        "mimeType": { "type": "string" },
        "sizeBytes": { "type": "integer" },
        "sha256": { "type": "string" },
        "storageProvider": { "type": "string", "enum": ["gcs", "local_temp"] }
      },
      "required": ["assetId", "objectKey", "url", "mimeType", "sizeBytes", "sha256", "storageProvider"]
    },
    "BankQuestionOverride": {
      "title": "BankQuestionOverride",
      "description": "Public-safe QC status and visual overrides without answer keys.",
      "type": "object",
      "properties": {
        "questionId": { "type": "string" },
        "qcStatus": { "type": "string" },
        "visual": { "type": "object" }
      },
      "required": ["questionId", "qcStatus"]
    },
    "QuestionFlag": {
      "title": "QuestionFlag",
      "description": "Issue report submitted by a learner and resolved by admin.",
      "type": "object",
      "properties": {
        "flagId": { "type": "string" },
        "userId": { "type": "string" },
        "questionId": { "type": "string" },
        "reason": { "type": "string" },
        "status": { "type": "string", "enum": ["open", "resolved"] }
      },
      "required": ["flagId", "userId", "questionId", "reason", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile document keyed by Firebase UID."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Isolated user PII document."
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminMarker" },
      "description": "Admin role allowlist keyed by Firebase UID."
    },
    "/users/{userId}/sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/StudySession" },
      "description": "User practice and mock test sessions."
    },
    "/users/{userId}/sessions/{sessionId}/snapshots/{snapId}": {
      "schema": { "$ref": "#/entities/SessionSnapshot" },
      "description": "Immutable session question snapshots (server-only)."
    },
    "/users/{userId}/attempts/{attemptId}": {
      "schema": { "$ref": "#/entities/PartAttempt" },
      "description": "Immutable server-graded question part attempts."
    },
    "/users/{userId}/skill_states/{skillDocId}": {
      "schema": { "$ref": "#/entities/UserSkillState" },
      "description": "Per-skill EWMA & SM-2 scheduling states."
    },
    "/users/{userId}/question_memory/{familyDocId}": {
      "schema": { "$ref": "#/entities/QuestionMemoryEntry" },
      "description": "Per-family spaced repetition tracking."
    },
    "/users/{userId}/question_evidence/{evidenceDocId}": {
      "schema": { "$ref": "#/entities/QuestionEvidence" },
      "description": "3-stage timed question mastery certification state."
    },
    "/users/{userId}/writing_submissions/{submissionId}": {
      "schema": { "$ref": "#/entities/WritingSubmission" },
      "description": "Student writing responses and rubric evaluations."
    },
    "/admin_configs/{configVersionId}": {
      "schema": { "$ref": "#/entities/AdminConfigVersion" },
      "description": "Immutable LearningConfig versions."
    },
    "/bank_stimuli/{stimulusId}": {
      "schema": { "$ref": "#/entities/BankStimulus" },
      "description": "Authoritative reading stimuli (server-only)."
    },
    "/bank_questions/{questionId}": {
      "schema": { "$ref": "#/entities/BankQuestion" },
      "description": "Authoritative full questions with answer keys (server-only)."
    },
    "/import_batches/{batchId}": {
      "schema": { "$ref": "#/entities/ImportBatch" },
      "description": "Manifest import batch history (server-only)."
    },
    "/media_assets/{assetId}": {
      "schema": { "$ref": "#/entities/MediaAsset" },
      "description": "Validated uploaded media metadata (server-only)."
    },
    "/bank_question_overrides/{questionId}": {
      "schema": { "$ref": "#/entities/BankQuestionOverride" },
      "description": "Legacy override metadata."
    },
    "/question_flags/{flagId}": {
      "schema": { "$ref": "#/entities/QuestionFlag" },
      "description": "Question issue reports."
    }
  }
}
