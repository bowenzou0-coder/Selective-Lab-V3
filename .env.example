# ==============================================================================
# Selective Lab — Environment Configuration Template (no secrets committed)
# ==============================================================================

# Gemini Writing Evaluation API Key (server-side only; Cloud Run secret)
GEMINI_API_KEY=""

# Public App Origin URL
APP_URL="http://localhost:3000"

# Cookie signing secret (REQUIRED in production)
SESSION_SECRET="dev-local-session-secret-change-in-prod"

# ------------------------------------------------------------------------------
# Firebase & Storage Configuration (Defaults align with firebase-applet-config.json)
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID="inductive-setting-553bd"
FIREBASE_DATABASE_ID="ai-studio-nswselectiveprac-b9b787e9-30e1-483b-b6a1-760d211f0835"
FIREBASE_STORAGE_BUCKET="inductive-setting-553bd.firebasestorage.app"
BOOTSTRAPPED_ADMIN_EMAIL="bowenzou0@gmail.com"

# Public client overrides (Vite exposes VITE_* variables to the browser)
VITE_FIREBASE_PROJECT_ID="inductive-setting-553bd"
VITE_FIREBASE_DATABASE_ID="ai-studio-nswselectiveprac-b9b787e9-30e1-483b-b6a1-760d211f0835"
VITE_FIREBASE_STORAGE_BUCKET="inductive-setting-553bd.firebasestorage.app"

# ------------------------------------------------------------------------------
# Local Development Mode (Emulators by default; opt-in ADC/demo)
# ------------------------------------------------------------------------------
# Set these when running `npm run emulators` locally:
FIRESTORE_EMULATOR_HOST="127.0.0.1:8080"
FIREBASE_AUTH_EMULATOR_HOST="127.0.0.1:9099"
FIREBASE_STORAGE_EMULATOR_HOST="127.0.0.1:9199"
VITE_FIREBASE_AUTH_EMULATOR_HOST="127.0.0.1:9099"
VITE_FIRESTORE_EMULATOR_HOST="127.0.0.1:8080"

# Opt-in explicit live ADC usage locally (when emulators are NOT running):
USE_FIRESTORE_DB="true"
FIREBASE_USE_ADC="false"

# Local dev PIN / Password (NEVER enable in production)
ALLOW_LOCAL_DEV_PIN="true"
STUDENT_PIN="1234"
ADMIN_PASSWORD="admin-dev"

# Disposable in-memory preview fallback (strictly for isolated sandbox / CI demos)
ALLOW_DEMO_MEMORY_DB="false"
