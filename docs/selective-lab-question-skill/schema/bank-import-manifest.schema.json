{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SelectiveLabBankImportManifest",
  "type": "object",
  "required": [
    "manifestVersion",
    "batchLabel",
    "questions"
  ],
  "properties": {
    "manifestVersion": {
      "type": "string",
      "const": "1.0"
    },
    "batchLabel": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}_b\\d{2,}$",
      "description": "Date + daily batch number: YYYY-MM-DD_bNN (e.g. 2026-11-22_b01)"
    },
    "defaultPoolType": {
      "type": "string",
      "enum": [
        "practice",
        "diagnostic",
        "official_calibration",
        "benchmark_holdout"
      ],
      "default": "practice"
    },
    "defaultQcStatus": {
      "type": "string",
      "enum": [
        "active",
        "verified",
        "draft"
      ],
      "default": "active"
    },
    "stimuli": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "required": [
          "stimulusId",
          "section",
          "genreOrTextType"
        ],
        "properties": {
          "stimulusId": {
            "type": "string",
            "description": "<batchLabel>_<sec>_s<nn>_v<version> (e.g. 2026-11-22_b01_read_s01_v1)"
          },
          "stimulusFamilyId": {
            "type": "string",
            "description": "<batchLabel>_<sec>_s<nn> (e.g. 2026-11-22_b01_read_s01)"
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "default": 1
          },
          "section": {
            "type": "string",
            "enum": [
              "READ",
              "MATH",
              "THINK",
              "WRIT"
            ]
          },
          "genreOrTextType": {
            "type": "string",
            "description": "e.g. narrative, informational_cloze, poem, gapped_text, multiple_match, paired_extracts"
          },
          "title": {
            "type": "string"
          },
          "preamble": {
            "type": "string"
          },
          "mainTextMarkdown": {
            "type": "string",
            "description": "Use {{gap:1}}, {{gap:2}} placeholders for READ_VOCAB_CLOZE and READ_GAPPED_TEXT"
          },
          "extracts": {
            "type": "array",
            "description": "Labeled extracts A-H for gapped_text (with optional decoy), multiple_match, or paired passages",
            "items": {
              "type": "object",
              "required": [
                "label",
                "bodyMarkdown"
              ],
              "properties": {
                "label": {
                  "type": "string",
                  "pattern": "^[A-H]$"
                },
                "title": {
                  "type": "string"
                },
                "bodyMarkdown": {
                  "type": "string"
                },
                "isDecoy": {
                  "type": "boolean"
                }
              }
            }
          },
          "visual": {
            "$ref": "#/$defs/VisualSpec"
          },
          "sourceType": {
            "type": "string",
            "enum": [
              "ai_generated",
              "human_authored",
              "official_doe"
            ],
            "default": "ai_generated"
          }
        }
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "questionId",
          "section",
          "formatType",
          "parts"
        ],
        "properties": {
          "questionId": {
            "type": "string",
            "description": "<batchLabel>_<sec>_<nn>_v<version> (e.g. 2026-11-22_b01_math_01_v1)"
          },
          "questionFamilyId": {
            "type": "string",
            "description": "<batchLabel>_<sec>_<nn> (e.g. 2026-11-22_b01_math_01)"
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "default": 1
          },
          "section": {
            "type": "string",
            "enum": [
              "READ",
              "MATH",
              "THINK",
              "WRIT"
            ]
          },
          "formatType": {
            "type": "string",
            "enum": [
              "READ_FICTION_MCQ",
              "READ_VOCAB_CLOZE",
              "READ_POETRY_MCQ",
              "READ_GAPPED_TEXT",
              "READ_MULTIPLE_MATCH",
              "MATH_MCQ_5",
              "THINK_MCQ_4",
              "WRIT_TYPED_TASK"
            ]
          },
          "poolType": {
            "type": "string",
            "enum": [
              "practice",
              "diagnostic",
              "official_calibration",
              "benchmark_holdout"
            ]
          },
          "qcStatus": {
            "type": "string",
            "enum": [
              "active",
              "verified",
              "draft",
              "quarantined",
              "retired"
            ]
          },
          "stimulusId": {
            "type": "string",
            "description": "References stimuli[].stimulusId when passage-based"
          },
          "transferGroupId": {
            "type": "string"
          },
          "stemPrefix": {
            "type": "string"
          },
          "visual": {
            "$ref": "#/$defs/VisualSpec"
          },
          "sharedPoolConfig": {
            "type": "object",
            "required": [
              "reuseAllowed",
              "poolKeys"
            ],
            "properties": {
              "reuseAllowed": {
                "type": "boolean",
                "description": "false for READ_GAPPED_TEXT, true for READ_MULTIPLE_MATCH"
              },
              "poolKeys": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 2,
                "maxItems": 8
              }
            }
          },
          "writingSpec": {
            "type": "object",
            "required": [
              "genre",
              "audience",
              "purpose",
              "recommendedWordRange",
              "timeLimitSec"
            ],
            "properties": {
              "genre": {
                "type": "string"
              },
              "audience": {
                "type": "string"
              },
              "purpose": {
                "type": "string"
              },
              "mandatoryOpeningLine": {
                "type": "string"
              },
              "bulletSuggestions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "recommendedWordRange": {
                "type": "array",
                "items": {
                  "type": "integer"
                },
                "minItems": 2,
                "maxItems": 2
              },
              "timeLimitSec": {
                "type": "integer",
                "default": 1800
              }
            }
          },
          "parts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "partId",
                "promptText",
                "skillId",
                "options",
                "correctAnswerKey"
              ],
              "properties": {
                "partId": {
                  "type": "string",
                  "description": "<questionFamilyId>_p<partIndex+1> (e.g. 2026-11-22_b01_math_01_p1)"
                },
                "partIndex": {
                  "type": "integer",
                  "minimum": 0
                },
                "slotRef": {
                  "type": "string",
                  "description": "Use gap:1, gap:2 for cloze/gapped_text"
                },
                "promptText": {
                  "type": "string"
                },
                "skillId": {
                  "type": "string",
                  "enum": [
                    "READ.FIC.LITERAL_DETAIL",
                    "READ.FIC.CHARACTER_INFERENCE",
                    "READ.FIC.IMPLIED_MEANING",
                    "READ.FIC.TONE_ATTITUDE",
                    "READ.FIC.TECHNIQUE_EFFECT",
                    "READ.FIC.TEXT_STRUCTURE",
                    "READ.CLOZE.COLLOCATION",
                    "READ.CLOZE.CONTEXT_NUANCE",
                    "READ.CLOZE.DISCOURSE_CONNECTOR",
                    "READ.POEM.LITERAL_SENSE",
                    "READ.POEM.FIGURATIVE_IMAGERY",
                    "READ.POEM.FORM_TONE_EFFECT",
                    "READ.GAP.COHESIVE_BRIDGE",
                    "READ.GAP.REFERENTIAL_PRONOUN_LINK",
                    "READ.GAP.PARAGRAPH_PROGRESSION",
                    "READ.MATCH.PRECISE_CONDITION",
                    "READ.MATCH.CROSS_TEXT_COMPARE",
                    "READ.MATCH.VIEWPOINT_CHANGE",
                    "MATH.NUM.DIVISIBILITY_REMAINDERS",
                    "MATH.NUM.NUMBER_SEQUENCES",
                    "MATH.NUM.PLACE_VALUE_DECIMALS",
                    "MATH.NUM.FACTORS_MULTIPLES_PRIMES",
                    "MATH.FRAC.FRACTION_CHAINS",
                    "MATH.FRAC.TRUE_FALSE_STATEMENTS",
                    "MATH.FRAC.RATIO_PROPORTION",
                    "MATH.FRAC.PERCENTAGES",
                    "MATH.FRAC.PROBABILITY_DEPENDENT",
                    "MATH.ALG.TWO_UNKNOWN_SYSTEMS",
                    "MATH.ALG.WORKING_BACKWARDS",
                    "MATH.ALG.SYMBOL_EQUATIONS",
                    "MATH.ALG.INEQUALITIES_BOUNDS",
                    "MATH.ALG.DIGIT_CRYPT_PUZZLES",
                    "MATH.TIME.ELAPSED_24H",
                    "MATH.TIME.TIME_ZONES_ITINERARY",
                    "MATH.TIME.CLOCK_ANGLES",
                    "MATH.MEAS.DIAL_GAUGE_OFFSET",
                    "MATH.MEAS.BALANCE_SCALES",
                    "MATH.MEAS.UNIT_CONVERSIONS",
                    "MATH.GEO2D.COMPOSITE_AREA",
                    "MATH.GEO2D.COMPOSITE_PERIMETER",
                    "MATH.GEO2D.ANGLES_PROTRACTOR",
                    "MATH.GEO2D.SYMMETRY_ROTATION_REFLECT",
                    "MATH.GEO2D.COMPASS_TURNS",
                    "MATH.GEO3D.CUBE_STACK_COUNT",
                    "MATH.GEO3D.NETS_SOLIDS",
                    "MATH.GEO3D.FACES_EDGES_VERTICES",
                    "MATH.DATA.BAR_LINE_GRAPHS",
                    "MATH.DATA.MEAN_RECONSTRUCTION",
                    "MATH.COMB.CONSTRAINED_OPTIMISATION",
                    "MATH.COMB.GRID_PATHS_COORDS",
                    "THINK.VERBAL.STRENGTHEN_ARGUMENT",
                    "THINK.VERBAL.WEAKEN_ARGUMENT",
                    "THINK.VERBAL.IDENTIFY_FLAW",
                    "THINK.VERBAL.IMPLICIT_ASSUMPTION",
                    "THINK.DEDUCT.WHOSE_REASONING_CORRECT",
                    "THINK.DEDUCT.CONDITIONAL_CONTRAPOSITIVE",
                    "THINK.DEDUCT.LOGIC_GRID_CONSTRAINTS",
                    "THINK.DEDUCT.LINE_CIRCLE_ARRANGEMENT",
                    "THINK.DEDUCT.DEDUCTIVE_ORDERING",
                    "THINK.DEDUCT.SET_SYLLOGISMS",
                    "THINK.DEDUCT.KNIGHTS_AND_LIARS",
                    "THINK.DEDUCT.CRYPTOGRAM_MAPPING",
                    "THINK.DEDUCT.CYCLE_CHAIN_REASONING",
                    "THINK.NUM.SYSTEMS_WORD_PUZZLES",
                    "THINK.NUM.MIN_COST_COMBINATIONS",
                    "THINK.NUM.TABLE_CHART_RATE_LOGIC",
                    "THINK.NUM.OVERLAP_COUNTING",
                    "THINK.NUM.NETWORK_GRAPH_ROUTES",
                    "THINK.SPATIAL.VIEWS_3D_SILHOUETTES",
                    "THINK.SPATIAL.FOLD_CUT_TILE_ASSEMBLY",
                    "THINK.SPATIAL.PATTERN_ROTATION_SYMMETRY",
                    "WRIT.CRIT.TOPIC_PROMPT_ADHERENCE",
                    "WRIT.CRIT.IDEAS_CREATIVITY",
                    "WRIT.CRIT.PURPOSE_AUDIENCE_VOICE",
                    "WRIT.CRIT.STRUCTURE_LAYOUT",
                    "WRIT.CRIT.STYLE_VOCABULARY",
                    "WRIT.CRIT.GRAMMAR_SPELLING_PUNCT"
                  ]
                },
                "secondarySkillIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "READ.FIC.LITERAL_DETAIL",
                      "READ.FIC.CHARACTER_INFERENCE",
                      "READ.FIC.IMPLIED_MEANING",
                      "READ.FIC.TONE_ATTITUDE",
                      "READ.FIC.TECHNIQUE_EFFECT",
                      "READ.FIC.TEXT_STRUCTURE",
                      "READ.CLOZE.COLLOCATION",
                      "READ.CLOZE.CONTEXT_NUANCE",
                      "READ.CLOZE.DISCOURSE_CONNECTOR",
                      "READ.POEM.LITERAL_SENSE",
                      "READ.POEM.FIGURATIVE_IMAGERY",
                      "READ.POEM.FORM_TONE_EFFECT",
                      "READ.GAP.COHESIVE_BRIDGE",
                      "READ.GAP.REFERENTIAL_PRONOUN_LINK",
                      "READ.GAP.PARAGRAPH_PROGRESSION",
                      "READ.MATCH.PRECISE_CONDITION",
                      "READ.MATCH.CROSS_TEXT_COMPARE",
                      "READ.MATCH.VIEWPOINT_CHANGE",
                      "MATH.NUM.DIVISIBILITY_REMAINDERS",
                      "MATH.NUM.NUMBER_SEQUENCES",
                      "MATH.NUM.PLACE_VALUE_DECIMALS",
                      "MATH.NUM.FACTORS_MULTIPLES_PRIMES",
                      "MATH.FRAC.FRACTION_CHAINS",
                      "MATH.FRAC.TRUE_FALSE_STATEMENTS",
                      "MATH.FRAC.RATIO_PROPORTION",
                      "MATH.FRAC.PERCENTAGES",
                      "MATH.FRAC.PROBABILITY_DEPENDENT",
                      "MATH.ALG.TWO_UNKNOWN_SYSTEMS",
                      "MATH.ALG.WORKING_BACKWARDS",
                      "MATH.ALG.SYMBOL_EQUATIONS",
                      "MATH.ALG.INEQUALITIES_BOUNDS",
                      "MATH.ALG.DIGIT_CRYPT_PUZZLES",
                      "MATH.TIME.ELAPSED_24H",
                      "MATH.TIME.TIME_ZONES_ITINERARY",
                      "MATH.TIME.CLOCK_ANGLES",
                      "MATH.MEAS.DIAL_GAUGE_OFFSET",
                      "MATH.MEAS.BALANCE_SCALES",
                      "MATH.MEAS.UNIT_CONVERSIONS",
                      "MATH.GEO2D.COMPOSITE_AREA",
                      "MATH.GEO2D.COMPOSITE_PERIMETER",
                      "MATH.GEO2D.ANGLES_PROTRACTOR",
                      "MATH.GEO2D.SYMMETRY_ROTATION_REFLECT",
                      "MATH.GEO2D.COMPASS_TURNS",
                      "MATH.GEO3D.CUBE_STACK_COUNT",
                      "MATH.GEO3D.NETS_SOLIDS",
                      "MATH.GEO3D.FACES_EDGES_VERTICES",
                      "MATH.DATA.BAR_LINE_GRAPHS",
                      "MATH.DATA.MEAN_RECONSTRUCTION",
                      "MATH.COMB.CONSTRAINED_OPTIMISATION",
                      "MATH.COMB.GRID_PATHS_COORDS",
                      "THINK.VERBAL.STRENGTHEN_ARGUMENT",
                      "THINK.VERBAL.WEAKEN_ARGUMENT",
                      "THINK.VERBAL.IDENTIFY_FLAW",
                      "THINK.VERBAL.IMPLICIT_ASSUMPTION",
                      "THINK.DEDUCT.WHOSE_REASONING_CORRECT",
                      "THINK.DEDUCT.CONDITIONAL_CONTRAPOSITIVE",
                      "THINK.DEDUCT.LOGIC_GRID_CONSTRAINTS",
                      "THINK.DEDUCT.LINE_CIRCLE_ARRANGEMENT",
                      "THINK.DEDUCT.DEDUCTIVE_ORDERING",
                      "THINK.DEDUCT.SET_SYLLOGISMS",
                      "THINK.DEDUCT.KNIGHTS_AND_LIARS",
                      "THINK.DEDUCT.CRYPTOGRAM_MAPPING",
                      "THINK.DEDUCT.CYCLE_CHAIN_REASONING",
                      "THINK.NUM.SYSTEMS_WORD_PUZZLES",
                      "THINK.NUM.MIN_COST_COMBINATIONS",
                      "THINK.NUM.TABLE_CHART_RATE_LOGIC",
                      "THINK.NUM.OVERLAP_COUNTING",
                      "THINK.NUM.NETWORK_GRAPH_ROUTES",
                      "THINK.SPATIAL.VIEWS_3D_SILHOUETTES",
                      "THINK.SPATIAL.FOLD_CUT_TILE_ASSEMBLY",
                      "THINK.SPATIAL.PATTERN_ROTATION_SYMMETRY",
                      "WRIT.CRIT.TOPIC_PROMPT_ADHERENCE",
                      "WRIT.CRIT.IDEAS_CREATIVITY",
                      "WRIT.CRIT.PURPOSE_AUDIENCE_VOICE",
                      "WRIT.CRIT.STRUCTURE_LAYOUT",
                      "WRIT.CRIT.STYLE_VOCABULARY",
                      "WRIT.CRIT.GRAMMAR_SPELLING_PUNCT"
                    ]
                  }
                },
                "difficultyInitial": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 5,
                  "default": 3
                },
                "targetTimeSec": {
                  "type": "integer",
                  "minimum": 10,
                  "default": 60
                },
                "cognitiveDemand": {
                  "type": "string",
                  "enum": [
                    "recall_locate",
                    "apply_procedural",
                    "analyze_infer",
                    "evaluate_transfer"
                  ],
                  "default": "apply_procedural"
                },
                "trapTags": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "options": {
                  "type": "array",
                  "description": "Up to 8 options (A-H) for MCQ/cloze; empty array [] allowed for WRIT_TYPED_TASK or sharedPoolConfig formats",
                  "maxItems": 8,
                  "items": {
                    "type": "object",
                    "required": [
                      "key",
                      "text"
                    ],
                    "properties": {
                      "key": {
                        "type": "string",
                        "pattern": "^[A-H]$"
                      },
                      "text": {
                        "type": "string"
                      },
                      "visual": {
                        "$ref": "#/$defs/VisualSpec"
                      }
                    }
                  }
                },
                "correctAnswerKey": {
                  "type": "string",
                  "description": "Option/extract key A-H (empty string for WRIT_TYPED_TASK)"
                },
                "workedExplanation": {
                  "type": "string"
                },
                "distractorRationales": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "evidenceRefs": {
                  "type": "array",
                  "description": "Optional anchored text spans in the linked stimulus justifying the answer",
                  "items": {
                    "type": "object",
                    "required": [
                      "refId",
                      "stimulusRevision",
                      "targetKind",
                      "startOffset",
                      "endOffset",
                      "quote"
                    ],
                    "properties": {
                      "refId": {
                        "type": "string"
                      },
                      "stimulusRevision": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "targetKind": {
                        "type": "string",
                        "enum": [
                          "mainText",
                          "extract"
                        ]
                      },
                      "extractLabel": {
                        "type": "string"
                      },
                      "startOffset": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "endOffset": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "quote": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "provenance": {
            "type": "object",
            "properties": {
              "sourceType": {
                "type": "string",
                "enum": [
                  "ai_generated",
                  "human_authored",
                  "official_doe"
                ]
              },
              "sourceReference": {
                "type": "string"
              },
              "verifierAgreed": {
                "type": "boolean"
              },
              "auditorReviewed": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "VisualSpec": {
      "type": "object",
      "required": [
        "visualType",
        "altText"
      ],
      "properties": {
        "visualType": {
          "type": "string",
          "enum": [
            "none",
            "inline_svg",
            "image_asset",
            "structured_table"
          ]
        },
        "altText": {
          "type": "string"
        },
        "svgMarkup": {
          "type": "string"
        },
        "imageUrl": {
          "type": "string",
          "description": "Relative path under /assets/... or HTTPS URL"
        },
        "caption": {
          "type": "string"
        },
        "tableData": {
          "type": "object",
          "required": [
            "headers",
            "rows"
          ],
          "properties": {
            "headers": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "rows": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": [
                    "string",
                    "number"
                  ]
                }
              }
            },
            "caption": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
