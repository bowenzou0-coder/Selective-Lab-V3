{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "PORT=3000 tsx server.ts",
    "dev:demo": "ALLOW_DEMO_MEMORY_DB=true ALLOW_LOCAL_DEV_PIN=true tsx server.ts",
    "start": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx --test src/shared/*.test.ts src/client/*.test.ts src/server/*.test.ts src/server/storage/*.test.ts",
    "migrate:preflight": "tsx scripts/migrate-preflight.ts",
    "deploy": "vercel --prod",
    "db:push": "tsx scripts/push-manifest.ts"
  },
  "dependencies": {
    "@google/genai": "^3.3.0",
    "@tailwindcss/vite": "^4.3.3",
