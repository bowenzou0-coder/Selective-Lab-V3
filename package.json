    "test": "tsx --test src/shared/*.test.ts src/server/*.test.ts src/server/storage/*.test.ts firestore.rules.test.ts",
    "emulators": "firebase emulators:start --project inductive-setting-553bd",
    "seed": "tsx scripts/seed-firestore.ts",
