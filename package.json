    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "google-auth-library": "^11.3.4",
    "lucide-react": "^0.546.0",
    "pg": "^8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "firebase-admin": "^14.5.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vercel": "^66.6.0"
