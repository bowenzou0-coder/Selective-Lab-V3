rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 0: Zero-trust default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Global Hardened Primitives
    // -------------------------------------------------------------------------
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    // Sole admin for now: bowenzou0@gmail.com (verified email required)
    function isAdmin() {
      return isVerifiedUser() &&
        ('email' in request.auth.token) &&
        request.auth.token.email is string &&
        request.auth.token.email.lower() == 'bowenzou0@gmail.com';
    }

    // -------------------------------------------------------------------------
    // Validation Blueprints (Anti-Update-Gap Helpers)
    // -------------------------------------------------------------------------
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'role', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'displayName', 'role', 'createdAt', 'updatedAt']) &&
        isValidId(data.uid) &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
        data.role in ['student', 'admin'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'createdAt', 'updatedAt']) &&
        isValidId(data.uid) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 200 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSession(data) {
      return data.keys().hasAll([
          'sessionId', 'userId', 'studentId', 'configVersionId', 'mode',
          'isSandbox', 'status', 'plannedQuestionIds', 'checkpoint',
          'totalSlots', 'correctSlots', 'startedAt', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'sessionId', 'userId', 'studentId', 'configVersionId', 'mode',
          'title', 'sectionFilter', 'mockBatch', 'timeMultiplier',
          'isSandbox', 'status', 'plannedQuestionIds', 'selectionDecision',
          'checkpoint', 'checkpointRevision', 'submissionSummary',
          'timeLimitSec', 'deadlineAt', 'expiredAutoSubmitted',
          'totalSlots', 'correctSlots', 'startedAt', 'completedAt',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.sessionId) &&
        isValidId(data.userId) &&
        data.studentId is string && data.studentId.size() >= 1 && data.studentId.size() <= 128 &&
        data.configVersionId is string && data.configVersionId.size() >= 1 && data.configVersionId.size() <= 128 &&
        data.mode in ['daily_adaptive', 'diagnostic', 'spaced_review', 'section_drill', 'writing_sprint', 'benchmark_exam', 'admin_calibration'] &&
        (!('title' in data) || (data.title is string && data.title.size() <= 200)) &&
        (!('sectionFilter' in data) || (data.sectionFilter is string && data.sectionFilter.size() <= 16)) &&
        (!('mockBatch' in data) || (data.mockBatch is string && data.mockBatch.size() <= 16)) &&
        (!('timeMultiplier' in data) || data.timeMultiplier is number) &&
        data.isSandbox is bool &&
        data.status in ['in_progress', 'submitted'] &&
        data.plannedQuestionIds is list && data.plannedQuestionIds.size() <= 200 &&
        (data.plannedQuestionIds.size() == 0 || data.plannedQuestionIds[0] is string) &&
        data.checkpoint is map &&
        (!('checkpointRevision' in data) || (data.checkpointRevision is int && data.checkpointRevision >= 0)) &&
        (!('selectionDecision' in data) || data.selectionDecision is map) &&
        (!('submissionSummary' in data) || data.submissionSummary is map) &&
        (!('timeLimitSec' in data) || (data.timeLimitSec is int && data.timeLimitSec >= 0 && data.timeLimitSec <= 86400)) &&
        (!('deadlineAt' in data) || (data.deadlineAt is string && data.deadlineAt.size() <= 64)) &&
        (!('expiredAutoSubmitted' in data) || data.expiredAutoSubmitted is bool) &&
        data.totalSlots is int && data.totalSlots >= 0 &&
        data.correctSlots is int && data.correctSlots >= 0 &&
        data.startedAt is string && data.startedAt.size() >= 10 && data.startedAt.size() <= 64 &&
        (!('completedAt' in data) || (data.completedAt is string && data.completedAt.size() <= 64)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSessionSnapshot(data) {
      return data.keys().hasAll(['userId', 'questionId', 'snapshotIndex', 'evidenceRevision', 'question', 'createdAt']) &&
        data.keys().hasOnly(['userId', 'questionId', 'snapshotIndex', 'evidenceRevision', 'question', 'stimulus', 'createdAt']) &&
        isValidId(data.userId) &&
        data.questionId is string && data.questionId.size() >= 1 && data.questionId.size() <= 128 &&
        data.snapshotIndex is int && data.snapshotIndex >= 0 && data.snapshotIndex <= 500 &&
        data.evidenceRevision is string && data.evidenceRevision.size() >= 1 && data.evidenceRevision.size() <= 128 &&
        data.question is map &&
        (!('stimulus' in data) || data.stimulus is map) &&
        data.createdAt is timestamp;
    }

    function isValidPartAttempt(data) {
      return data.keys().hasAll([
          'attemptId', 'userId', 'sessionId', 'questionId', 'questionFamilyId',
          'partId', 'skillId', 'difficultyAtAttempt', 'isCorrect', 'timeSpentSec',
          'isSpacedReview', 'createdAtIso', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'attemptId', 'userId', 'studentId', 'sessionId', 'questionId', 'questionFamilyId',
          'questionVersion', 'evidenceRevision', 'partId', 'skillId',
          'difficultyAtAttempt', 'selectedAnswer', 'isCorrect', 'timeSpentSec',
          'isSpacedReview', 'isSandbox', 'isLegacy', 'assisted', 'createdAtIso', 'createdAt'
        ]) &&
        isValidId(data.attemptId) &&
        isValidId(data.userId) &&
        (!('studentId' in data) || (data.studentId is string && data.studentId.size() <= 128)) &&
        data.sessionId is string && data.sessionId.size() >= 1 && data.sessionId.size() <= 128 &&
        data.questionId is string && data.questionId.size() >= 1 && data.questionId.size() <= 128 &&
        data.questionFamilyId is string && data.questionFamilyId.size() >= 1 && data.questionFamilyId.size() <= 128 &&
        (!('questionVersion' in data) || data.questionVersion is int) &&
        (!('evidenceRevision' in data) || (data.evidenceRevision is string && data.evidenceRevision.size() <= 128)) &&
        data.partId is string && data.partId.size() >= 1 && data.partId.size() <= 128 &&
        data.skillId is string && data.skillId.size() >= 1 && data.skillId.size() <= 128 &&
        data.difficultyAtAttempt is number &&
        (!('selectedAnswer' in data) || data.selectedAnswer == null || (data.selectedAnswer is string && data.selectedAnswer.size() <= 16)) &&
        data.isCorrect is bool &&
        data.timeSpentSec is number && data.timeSpentSec >= 0 &&
        data.isSpacedReview is bool &&
        (!('isSandbox' in data) || data.isSandbox is bool) &&
        (!('isLegacy' in data) || data.isLegacy is bool) &&
        (!('assisted' in data) || data.assisted is bool) &&
        data.createdAtIso is string && data.createdAtIso.size() >= 10 && data.createdAtIso.size() <= 64 &&
        data.createdAt is timestamp;
    }

    function isValidSkillState(data) {
      return data.keys().hasAll([
          'userId', 'skillId', 'masteryScore', 'attemptsCount',
          'reviewIntervalDays', 'easeFactor', 'plateauStatus', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId', 'skillId', 'ewmaAccuracy', 'avgTimeRatio', 'masteryScore',
          'uncertainty', 'attemptsCount', 'correctCount', 'reviewIntervalDays',
          'easeFactor', 'lastPracticedAt', 'nextReviewAt', 'nextDueAt',
          'plateauStatus', 'updatedAt'
        ]) &&
        isValidId(data.userId) &&
        data.skillId is string && data.skillId.size() >= 1 && data.skillId.size() <= 128 &&
        (!('ewmaAccuracy' in data) || data.ewmaAccuracy is number) &&
        (!('avgTimeRatio' in data) || data.avgTimeRatio is number) &&
        data.masteryScore is number &&
        (!('uncertainty' in data) || data.uncertainty is number) &&
        data.attemptsCount is int && data.attemptsCount >= 0 &&
        (!('correctCount' in data) || (data.correctCount is int && data.correctCount >= 0)) &&
        data.reviewIntervalDays is number &&
        data.easeFactor is number &&
        (!('lastPracticedAt' in data) || (data.lastPracticedAt is string && data.lastPracticedAt.size() <= 64)) &&
        (!('nextReviewAt' in data) || (data.nextReviewAt is string && data.nextReviewAt.size() <= 64)) &&
        (!('nextDueAt' in data) || (data.nextDueAt is string && data.nextDueAt.size() <= 64)) &&
        data.plateauStatus in ['none', 'watch', 'detected'] &&
        data.updatedAt is timestamp;
    }

    function isValidQuestionMemory(data) {
      return data.keys().hasAll([
          'userId', 'questionFamilyId', 'lastSeenAt', 'nextDueAt',
          'intervalDays', 'easeFactor', 'lapseCount', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId', 'questionFamilyId', 'timesSeen', 'lastSeenAt', 'lastAllCorrect',
          'nextDueAt', 'intervalDays', 'easeFactor', 'lapseCount',
          'lastEvidenceStatus', 'lastOutcome', 'updatedAt'
        ]) &&
        isValidId(data.userId) &&
        data.questionFamilyId is string && data.questionFamilyId.size() >= 1 && data.questionFamilyId.size() <= 128 &&
        (!('timesSeen' in data) || (data.timesSeen is int && data.timesSeen >= 0)) &&
        data.lastSeenAt is string && data.lastSeenAt.size() <= 64 &&
        (!('lastAllCorrect' in data) || data.lastAllCorrect is bool) &&
        data.nextDueAt is string && data.nextDueAt.size() <= 64 &&
        data.intervalDays is number &&
        data.easeFactor is number &&
        data.lapseCount is int && data.lapseCount >= 0 &&
        (!('lastEvidenceStatus' in data) || data.lastEvidenceStatus in ['unseen', 'correct_once', 'awaiting_review', 'retained', 'needs_repair']) &&
        (!('lastOutcome' in data) || (data.lastOutcome is string && data.lastOutcome.size() <= 32)) &&
        data.updatedAt is timestamp;
    }

    function isValidQuestionEvidence(data) {
      return data.keys().hasAll([
          'userId', 'evidenceKey', 'questionFamilyId', 'evidenceRevision',
          'status', 'cleanPassesCount', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId', 'evidenceKey', 'questionFamilyId', 'questionId', 'evidenceRevision',
          'section', 'status', 'cleanPassesCount', 'passTimestampsIso',
          'everCleanPassed', 'firstSubmissionCleanPass', 'attemptsCount',
          'resetCount', 'lastAttemptAtIso', 'lastAllCorrect', 'nextEligibleAtIso',
          'policyVersion', 'updatedAtIso', 'updatedAt'
        ]) &&
        isValidId(data.userId) &&
        data.evidenceKey is string && data.evidenceKey.size() >= 1 && data.evidenceKey.size() <= 200 &&
        data.questionFamilyId is string && data.questionFamilyId.size() >= 1 && data.questionFamilyId.size() <= 128 &&
        (!('questionId' in data) || (data.questionId is string && data.questionId.size() <= 128)) &&
        data.evidenceRevision is string && data.evidenceRevision.size() >= 1 && data.evidenceRevision.size() <= 128 &&
        (!('section' in data) || data.section in ['READ', 'MATH', 'THINK', 'WRIT']) &&
        data.status in ['unseen', 'correct_once', 'awaiting_review', 'retained', 'needs_repair'] &&
        data.cleanPassesCount is int && data.cleanPassesCount >= 0 &&
        (!('passTimestampsIso' in data) || (data.passTimestampsIso is list && data.passTimestampsIso.size() <= 20 && (data.passTimestampsIso.size() == 0 || data.passTimestampsIso[0] is string))) &&
        (!('everCleanPassed' in data) || data.everCleanPassed is bool) &&
        (!('firstSubmissionCleanPass' in data) || data.firstSubmissionCleanPass is bool) &&
        (!('attemptsCount' in data) || (data.attemptsCount is int && data.attemptsCount >= 0)) &&
        (!('resetCount' in data) || (data.resetCount is int && data.resetCount >= 0)) &&
        (!('lastAttemptAtIso' in data) || (data.lastAttemptAtIso is string && data.lastAttemptAtIso.size() <= 64)) &&
        (!('lastAllCorrect' in data) || data.lastAllCorrect is bool) &&
        (!('nextEligibleAtIso' in data) || (data.nextEligibleAtIso is string && data.nextEligibleAtIso.size() <= 64)) &&
        (!('policyVersion' in data) || (data.policyVersion is string && data.policyVersion.size() <= 64)) &&
        (!('updatedAtIso' in data) || (data.updatedAtIso is string && data.updatedAtIso.size() <= 64)) &&
        data.updatedAt is timestamp;
    }

    function isValidWritingSubmission(data) {
      return data.keys().hasAll([
          'submissionId', 'userId', 'sessionId', 'questionId',
          'responseText', 'wordCount', 'submittedAt', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'submissionId', 'userId', 'studentId', 'sessionId', 'questionId',
          'planNotes', 'responseText', 'wordCount', 'timeSpentSec',
          'deterministicMetricsJson', 'evaluations', 'submittedAt',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.submissionId) &&
        isValidId(data.userId) &&
        (!('studentId' in data) || (data.studentId is string && data.studentId.size() <= 128)) &&
        data.sessionId is string && data.sessionId.size() >= 1 && data.sessionId.size() <= 128 &&
        data.questionId is string && data.questionId.size() >= 1 && data.questionId.size() <= 128 &&
        (!('planNotes' in data) || (data.planNotes is string && data.planNotes.size() <= 10000)) &&
        data.responseText is string && data.responseText.size() <= 30000 &&
        data.wordCount is int && data.wordCount >= 0 &&
        (!('timeSpentSec' in data) || (data.timeSpentSec is number && data.timeSpentSec >= 0)) &&
        (!('deterministicMetricsJson' in data) || (data.deterministicMetricsJson is string && data.deterministicMetricsJson.size() <= 5000)) &&
        (!('evaluations' in data) || (data.evaluations is list && data.evaluations.size() <= 10 && (data.evaluations.size() == 0 || data.evaluations[0] is map))) &&
        data.submittedAt is string && data.submittedAt.size() <= 64 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSessionLock(data) {
      return data.keys().hasAll(['userId', 'activeSessionId', 'updatedAt']) &&
        data.keys().hasOnly(['userId', 'activeSessionId', 'deadlineAt', 'updatedAt']) &&
        isValidId(data.userId) &&
        data.activeSessionId is string && data.activeSessionId.size() >= 1 && data.activeSessionId.size() <= 128 &&
        (!('deadlineAt' in data) || (data.deadlineAt is string && data.deadlineAt.size() <= 64)) &&
        data.updatedAt is timestamp;
    }

    function isValidDailyPlan(data) {
      return data.keys().hasAll([
          'planDate', 'studentId', 'generatedAtIso', 'source',
          'focusSkillIds', 'skillWeights', 'rationale', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'planDate', 'studentId', 'generatedAtIso', 'source', 'modelId',
          'focusSkillIds', 'skillWeights', 'algorithmAdjustments',
          'recommendedSection', 'dailyQuestionLimitBySection', 'dailyGoalMinutes',
          'autoCalibrated', 'rationale', 'updatedAt'
        ]) &&
        data.planDate is string && data.planDate.size() >= 8 && data.planDate.size() <= 16 &&
        data.studentId is string && data.studentId.size() >= 1 && data.studentId.size() <= 128 &&
        data.generatedAtIso is string && data.generatedAtIso.size() <= 64 &&
        data.source in ['gemini', 'deterministic'] &&
        (!('modelId' in data) || (data.modelId is string && data.modelId.size() <= 64)) &&
        data.focusSkillIds is list && data.focusSkillIds.size() <= 20 &&
        (data.focusSkillIds.size() == 0 || data.focusSkillIds[0] is string) &&
        data.skillWeights is map &&
        (!('algorithmAdjustments' in data) || data.algorithmAdjustments is map) &&
        (!('recommendedSection' in data) || data.recommendedSection in ['READ', 'MATH', 'THINK']) &&
        (!('dailyQuestionLimitBySection' in data) || data.dailyQuestionLimitBySection is map) &&
        (!('dailyGoalMinutes' in data) || (data.dailyGoalMinutes is int && data.dailyGoalMinutes >= 5 && data.dailyGoalMinutes <= 240)) &&
        (!('autoCalibrated' in data) || data.autoCalibrated is bool) &&
        data.rationale is string && data.rationale.size() <= 1000 &&
        data.updatedAt is timestamp;
    }

    function isValidAdminConfig(data) {
      return data.keys().hasAll(['configVersionId', 'versionNumber', 'config', 'createdAtIso', 'createdAt']) &&
        data.keys().hasOnly(['configVersionId', 'versionNumber', 'notes', 'config', 'createdAtIso', 'createdAt']) &&
        data.configVersionId is string && data.configVersionId.size() >= 1 && data.configVersionId.size() <= 128 &&
        data.versionNumber is int && data.versionNumber >= 1 &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 500)) &&
        data.config is map &&
        data.createdAtIso is string && data.createdAtIso.size() <= 64 &&
        data.createdAt is timestamp;
    }

    function isValidBankStimulus(data) {
      return data.keys().hasAll(['stimulusId', 'stimulusFamilyId', 'version', 'section', 'payload', 'updatedAt']) &&
        data.keys().hasOnly(['stimulusId', 'stimulusFamilyId', 'version', 'section', 'payload', 'createdAt', 'updatedAt']) &&
        data.stimulusId is string && data.stimulusId.size() >= 1 && data.stimulusId.size() <= 128 &&
        data.stimulusFamilyId is string && data.stimulusFamilyId.size() >= 1 && data.stimulusFamilyId.size() <= 128 &&
        data.version is int && data.version >= 1 &&
        data.section in ['READ', 'MATH', 'THINK', 'WRIT'] &&
        data.payload is map &&
        (!('createdAt' in data) || data.createdAt is timestamp) &&
        data.updatedAt is timestamp;
    }

    function isValidBankQuestion(data) {
      return data.keys().hasAll([
          'questionId', 'questionFamilyId', 'version', 'section',
          'formatType', 'poolType', 'qcStatus', 'payload', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'questionId', 'questionFamilyId', 'version', 'section',
          'formatType', 'poolType', 'qcStatus', 'batchId', 'batchLabel',
          'evidenceRevision', 'payload', 'createdAt', 'updatedAt'
        ]) &&
        data.questionId is string && data.questionId.size() >= 1 && data.questionId.size() <= 128 &&
        data.questionFamilyId is string && data.questionFamilyId.size() >= 1 && data.questionFamilyId.size() <= 128 &&
        data.version is int && data.version >= 1 &&
        data.section in ['READ', 'MATH', 'THINK', 'WRIT'] &&
        data.formatType is string && data.formatType.size() >= 1 && data.formatType.size() <= 64 &&
        data.poolType is string && data.poolType.size() >= 1 && data.poolType.size() <= 64 &&
        data.qcStatus in ['draft', 'verified', 'active', 'quarantined', 'retired'] &&
        (!('batchId' in data) || (data.batchId is string && data.batchId.size() <= 128)) &&
        (!('batchLabel' in data) || (data.batchLabel is string && data.batchLabel.size() <= 200)) &&
        (!('evidenceRevision' in data) || (data.evidenceRevision is string && data.evidenceRevision.size() <= 128)) &&
        data.payload is map &&
        (!('createdAt' in data) || data.createdAt is timestamp) &&
        data.updatedAt is timestamp;
    }

    function isValidImportBatch(data) {
      return data.keys().hasAll(['batchId', 'batchLabel', 'createdAtIso', 'importedBy', 'questionsCount', 'createdAt']) &&
        data.keys().hasOnly([
          'batchId', 'batchLabel', 'createdAtIso', 'importedBy', 'questionsCount',
          'stimuliCount', 'newQuestionIds', 'versionBumpedQuestionIds', 'skippedQuestionIds',
          'newQuestions', 'versionBumpedQuestions', 'unchangedQuestions', 'createdAt'
        ]) &&
        data.batchId is string && data.batchId.size() >= 1 && data.batchId.size() <= 128 &&
        data.batchLabel is string && data.batchLabel.size() >= 1 && data.batchLabel.size() <= 200 &&
        data.createdAtIso is string && data.createdAtIso.size() <= 64 &&
        data.importedBy is string && data.importedBy.size() >= 1 && data.importedBy.size() <= 128 &&
        data.questionsCount is int && data.questionsCount >= 0 &&
        (!('stimuliCount' in data) || (data.stimuliCount is int && data.stimuliCount >= 0)) &&
        (!('newQuestionIds' in data) || (data.newQuestionIds is list && data.newQuestionIds.size() <= 500 && (data.newQuestionIds.size() == 0 || data.newQuestionIds[0] is string))) &&
        (!('versionBumpedQuestionIds' in data) || (data.versionBumpedQuestionIds is list && data.versionBumpedQuestionIds.size() <= 500 && (data.versionBumpedQuestionIds.size() == 0 || data.versionBumpedQuestionIds[0] is string))) &&
        (!('skippedQuestionIds' in data) || (data.skippedQuestionIds is list && data.skippedQuestionIds.size() <= 500 && (data.skippedQuestionIds.size() == 0 || data.skippedQuestionIds[0] is string))) &&
        (!('newQuestions' in data) || (data.newQuestions is int && data.newQuestions >= 0)) &&
        (!('versionBumpedQuestions' in data) || (data.versionBumpedQuestions is int && data.versionBumpedQuestions >= 0)) &&
        (!('unchangedQuestions' in data) || (data.unchangedQuestions is int && data.unchangedQuestions >= 0)) &&
        data.createdAt is timestamp;
    }

    function isValidMediaAsset(data) {
      return data.keys().hasAll(['assetId', 'objectKey', 'url', 'mimeType', 'sizeBytes', 'sha256', 'storageProvider', 'createdAt']) &&
        data.keys().hasOnly(['assetId', 'objectKey', 'url', 'mimeType', 'sizeBytes', 'sha256', 'storageProvider', 'questionId', 'createdAt']) &&
        data.assetId is string && data.assetId.size() >= 1 && data.assetId.size() <= 128 &&
        data.objectKey is string && data.objectKey.size() >= 1 && data.objectKey.size() <= 300 &&
        data.url is string && data.url.size() >= 1 && data.url.size() <= 2000 &&
        data.mimeType is string && data.mimeType.size() >= 1 && data.mimeType.size() <= 100 &&
        data.sizeBytes is int && data.sizeBytes >= 0 &&
        data.sha256 is string && data.sha256.size() >= 1 && data.sha256.size() <= 128 &&
        data.storageProvider in ['gcs', 'local_temp', 'inline_data'] &&
        (!('questionId' in data) || (data.questionId is string && data.questionId.size() <= 128)) &&
        data.createdAt is timestamp;
    }

    function isValidBankOverride(data) {
      return data.keys().hasAll(['questionId', 'qcStatus', 'updatedAt']) &&
        data.keys().hasOnly(['questionId', 'qcStatus', 'visual', 'updatedAt']) &&
        data.questionId is string && data.questionId.size() >= 1 && data.questionId.size() <= 128 &&
        data.qcStatus in ['draft', 'verified', 'active', 'quarantined', 'retired'] &&
        (!('visual' in data) || data.visual is map) &&
        data.updatedAt is timestamp;
    }

    function isValidQuestionFlag(data) {
      return data.keys().hasAll(['flagId', 'userId', 'questionId', 'reason', 'status', 'createdAtIso', 'createdAt']) &&
        data.keys().hasOnly(['flagId', 'userId', 'sessionId', 'questionId', 'reason', 'notes', 'status', 'createdAtIso', 'resolvedAtIso', 'createdAt', 'updatedAt']) &&
        isValidId(data.flagId) &&
        isValidId(data.userId) &&
        (!('sessionId' in data) || (data.sessionId is string && data.sessionId.size() <= 128)) &&
        data.questionId is string && data.questionId.size() >= 1 && data.questionId.size() <= 128 &&
        data.reason is string && data.reason.size() >= 1 && data.reason.size() <= 200 &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 2000)) &&
        data.status in ['open', 'resolved'] &&
        data.createdAtIso is string && data.createdAtIso.size() <= 64 &&
        (!('resolvedAtIso' in data) || (data.resolvedAtIso is string && data.resolvedAtIso.size() <= 64)) &&
        data.createdAt is timestamp &&
        (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    // -------------------------------------------------------------------------
    // Collection Rules
    // -------------------------------------------------------------------------

    // Connection probe
    match /test/connection {
      allow get: if isSignedIn();
      allow write: if false;
    }

    // Admin markers locked down (sole admin is bowenzou0@gmail.com via verified email claim)
    match /admins/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }

    // Learner profile & strictly owner-scoped subcollections
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isVerifiedUser() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isValidId(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == userId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (isOwner(userId) && incoming().role == 'student')
        );
      allow update: if isValidId(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == userId &&
        (!('uid' in existing()) || incoming().uid == existing().uid) &&
        (!('createdAt' in existing()) || !(existing().createdAt is timestamp) || incoming().createdAt == existing().createdAt) &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (isOwner(userId) && incoming().role == 'student' && (!('role' in existing()) || incoming().role == existing().role) && incoming().diff(existing()).affectedKeys().hasOnly(['uid', 'displayName', 'role', 'createdAt', 'updatedAt']))
        );
      allow delete: if false;

      // Isolated PII document (email)
      match /private/{docId} {
        allow get: if isValidId(userId) && docId == 'info' && (isOwner(userId) || isAdmin());
        allow list: if false;
        allow create: if isValidId(userId) && docId == 'info' &&
          isValidUserPrivateInfo(incoming()) &&
          incoming().uid == userId &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          (isOwner(userId) || isAdmin());
        allow update: if isValidId(userId) && docId == 'info' &&
          isValidUserPrivateInfo(incoming()) &&
          incoming().uid == userId &&
          (!('uid' in existing()) || incoming().uid == existing().uid) &&
          (!('createdAt' in existing()) || !(existing().createdAt is timestamp) || incoming().createdAt == existing().createdAt) &&
          incoming().updatedAt == request.time &&
          (isOwner(userId) || isAdmin()) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['uid', 'email', 'createdAt', 'updatedAt']);
        allow delete: if false;
      }

      match /sessions/{sessionId} {
        allow get: if isValidId(userId) && isValidId(sessionId) && (isOwner(userId) || isAdmin());
        allow list: if isVerifiedUser() && (resource.data.userId == request.auth.uid || isAdmin());
        allow create: if isValidId(userId) && isValidId(sessionId) &&
          isValidSession(incoming()) &&
          incoming().userId == userId &&
          incoming().sessionId == sessionId &&
          incoming().status == 'in_progress' &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          (isOwner(userId) || isAdmin()) &&
          exists(/databases/$(database)/documents/users/$(userId));
        allow update: if isValidId(userId) && isValidId(sessionId) &&
          isValidSession(incoming()) &&
          incoming().userId == existing().userId &&
          incoming().sessionId == existing().sessionId &&
          incoming().startedAt == existing().startedAt &&
          incoming().mode == existing().mode &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time && (
            isAdmin() ||
            (
              isOwner(userId) &&
              existing().status == 'in_progress' && (
                (incoming().status == 'in_progress' && incoming().diff(existing()).affectedKeys().hasOnly(['checkpoint', 'checkpointRevision', 'updatedAt'])) ||
                (incoming().status == 'submitted' && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'checkpoint', 'checkpointRevision', 'submissionSummary', 'correctSlots', 'totalSlots', 'completedAt', 'expiredAutoSubmitted', 'updatedAt']))
              )
            )
          );
        allow delete: if isValidId(userId) && isValidId(sessionId) && (isOwner(userId) || isAdmin());

        match /snapshots/{snapId} {
          allow get: if isValidId(userId) && isValidId(sessionId) && isValidId(snapId) && (isOwner(userId) || isAdmin());
          allow list: if isVerifiedUser() && (resource.data.userId == request.auth.uid || isAdmin());
          allow create: if isValidId(userId) && isValidId(sessionId) && isValidId(snapId) &&
            isValidSessionSnapshot(incoming()) &&
            incoming().userId == userId &&
            incoming().createdAt == request.time &&
            (isOwner(userId) || isAdmin()) && (
              exists(/databases/$(database)/documents/users/$(userId)/sessions/$(sessionId)) ||
              existsAfter(/databases/$(database)/documents/users/$(userId)/sessions/$(sessionId))
            );
          allow update: if false;
          allow delete: if isValidId(userId) && isValidId(sessionId) && isValidId(snapId) && (isOwner(userId) || isAdmin());
        }
      }

      match /attempts/{attemptId} {
        allow get: if isValidId(userId) && isValidId(attemptId) && (isOwner(userId) || isAdmin());
        allow list: if isVerifiedUser() && (resource.data.userId == request.auth.uid || isAdmin());
        allow create: if isValidId(userId) && isValidId(attemptId) &&
          isValidPartAttempt(incoming()) &&
          incoming().userId == userId &&
          incoming().attemptId == attemptId &&
          incoming().createdAt == request.time &&
          (isOwner(userId) || isAdmin()) &&
          exists(/databases/$(database)/documents/users/$(userId));
        allow update: if false;
        allow delete: if isValidId(userId) && isValidId(attemptId) && (isOwner(userId) || isAdmin());
      }

      match /skill_states/{skillDocId} {
        allow get: if isValidId(userId) && isValidId(skillDocId) && (isOwner(userId) || isAdmin());
        allow list: if isVerifiedUser() && (resource.data.userId == request.auth.uid || isAdmin());
        allow create: if isValidId(userId) && isValidId(skillDocId) &&
          isValidSkillState(incoming()) &&
          incoming().userId == userId &&
          incoming().updatedAt == request.time &&
          (isOwner(userId) || isAdmin()) &&
          exists(/databases/$(database)/documents/users/$(userId));
        allow update: if isValidId(userId) && isValidId(skillDocId) &&
          isValidSkillState(incoming()) &&
          incoming().userId == existing().userId &&
          incoming().skillId == existing().skillId &&
          incoming().updatedAt == request.time && (
            isAdmin() ||
            (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['ewmaAccuracy', 'avgTimeRatio', 'masteryScore', 'uncertainty', 'attemptsCount', 'correctCount', 'reviewIntervalDays', 'easeFactor', 'lastPracticedAt', 'nextReviewAt', 'nextDueAt', 'plateauStatus', 'updatedAt']))
          );
        allow delete: if isValidId(userId) && isValidId(skillDocId) && (isOwner(userId) || isAdmin());
      }

      match /question_memory/{familyDocId} {
        allow get: if isValidId(userId) && isValidId(familyDocId) && (isOwner(userId) || isAdmin());
        allow list: if isVerifiedUser() && (resource.data.userId == request.auth.uid || isAdmin());
        allow create: if isValidId(userId) && isValidId(familyDocId) &&
          isValidQuestionMemory(incoming()) &&
          incoming().userId == userId &&
          incoming().updatedAt == request.time &&
          (isOwner(userId) || isAdmin()) &&
          exists(/databases/$(database)/documents/users/$(userId));
        allow update: if isValidId(userId) && isValidId(familyDocId) &&
          isValidQuestionMemory(incoming()) &&
          incoming().userId == existing().userId &&
          incoming().questionFamilyId == existing().questionFamilyId &&
          incoming().updatedAt == request.time && (
            isAdmin() ||
            (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['timesSeen', 'lastSeenAt', 'lastAllCorrect', 'nextDueAt', 'intervalDays', 'easeFactor', 'lapseCount', 'lastEvidenceStatus', 'lastOutcome', 'updatedAt']))
          );
        allow delete: if isValidId(userId) && isValidId(familyDocId) && (isOwner(userId) || isAdmin());
      }

      match /question_evidence/{evidenceDocId} {
        allow get: if isValidId(userId) && isValidId(evidenceDocId) && (isOwner(userId) || isAdmin());
        allow list: if isVerifiedUser() && (resource.data.userId == request.auth.uid || isAdmin());
        allow create: if isValidId(userId) && isValidId(evidenceDocId) &&
          isValidQuestionEvidence(incoming()) &&
          incoming().userId == userId &&
          incoming().updatedAt == request.time &&
          (isOwner(userId) || isAdmin()) &&
          exists(/databases/$(database)/documents/users/$(userId));
        allow update: if isValidId(userId) && isValidId(evidenceDocId) &&
          isValidQuestionEvidence(incoming()) &&
          incoming().userId == existing().userId &&
          incoming().evidenceKey == existing().evidenceKey &&
          incoming().updatedAt == request.time && (
            isAdmin() ||
            (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['questionId', 'section', 'status', 'cleanPassesCount', 'passTimestampsIso', 'everCleanPassed', 'firstSubmissionCleanPass', 'attemptsCount', 'resetCount', 'lastAttemptAtIso', 'lastAllCorrect', 'nextEligibleAtIso', 'policyVersion', 'updatedAtIso', 'updatedAt']))
          );
        allow delete: if isValidId(userId) && isValidId(evidenceDocId) && (isOwner(userId) || isAdmin());
      }

      match /writing_submissions/{submissionId} {
        allow get: if isValidId(userId) && isValidId(submissionId) && (isOwner(userId) || isAdmin());
        allow list: if isVerifiedUser() && (resource.data.userId == request.auth.uid || isAdmin());
        allow create: if isValidId(userId) && isValidId(submissionId) &&
          isValidWritingSubmission(incoming()) &&
          incoming().userId == userId &&
          incoming().submissionId == submissionId &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          (isOwner(userId) || isAdmin()) &&
          exists(/databases/$(database)/documents/users/$(userId));
        allow update: if isValidId(userId) && isValidId(submissionId) &&
          isValidWritingSubmission(incoming()) &&
          incoming().userId == existing().userId &&
          incoming().submissionId == existing().submissionId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time && (
            isAdmin() ||
            (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['evaluations', 'updatedAt']))
          );
        allow delete: if isValidId(userId) && isValidId(submissionId) && (isOwner(userId) || isAdmin());
      }

      match /locks/{lockId} {
        allow get: if isValidId(userId) && lockId == 'active_session' && (isOwner(userId) || isAdmin());
        allow list: if false;
        allow create: if isValidId(userId) && lockId == 'active_session' &&
          isValidSessionLock(incoming()) &&
          incoming().userId == userId &&
          incoming().updatedAt == request.time &&
          (isOwner(userId) || isAdmin()) &&
          exists(/databases/$(database)/documents/users/$(userId));
        allow update: if isValidId(userId) && lockId == 'active_session' &&
          isValidSessionLock(incoming()) &&
          incoming().userId == existing().userId &&
          incoming().updatedAt == request.time && (
            isAdmin() ||
            (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['activeSessionId', 'deadlineAt', 'updatedAt']))
          );
        allow delete: if isValidId(userId) && lockId == 'active_session' && (isOwner(userId) || isAdmin());
      }

      match /daily_plans/{planDate} {
        allow get: if isValidId(userId) && isValidId(planDate) && (isOwner(userId) || isAdmin());
        allow list: if isVerifiedUser() && (resource.data.studentId == request.auth.uid || isAdmin());
        allow create: if isValidId(userId) && isValidId(planDate) &&
          isValidDailyPlan(incoming()) &&
          incoming().studentId == userId &&
          incoming().updatedAt == request.time &&
          (isOwner(userId) || isAdmin()) &&
          exists(/databases/$(database)/documents/users/$(userId));
        allow update: if isValidId(userId) && isValidId(planDate) &&
          isValidDailyPlan(incoming()) &&
          incoming().studentId == existing().studentId &&
          incoming().planDate == existing().planDate &&
          incoming().updatedAt == request.time && (
            isAdmin() ||
            (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['generatedAtIso', 'source', 'modelId', 'focusSkillIds', 'skillWeights', 'algorithmAdjustments', 'recommendedSection', 'dailyQuestionLimitBySection', 'dailyGoalMinutes', 'autoCalibrated', 'rationale', 'updatedAt']))
          );
        allow delete: if isValidId(userId) && isValidId(planDate) && (isOwner(userId) || isAdmin());
      }
    }

    // Configuration versions: verified read, sole-admin create (immutable)
    match /admin_configs/{configVersionId} {
      allow get: if isValidId(configVersionId) && isVerifiedUser();
      allow list: if isVerifiedUser() && (resource.data.versionNumber >= 1 || isAdmin());
      allow create: if isValidId(configVersionId) &&
        isAdmin() &&
        isValidAdminConfig(incoming()) &&
        incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    // Question bank & stimuli: verified read, sole-admin write
    match /bank_stimuli/{stimulusId} {
      allow get: if isValidId(stimulusId) && isVerifiedUser();
      allow list: if isVerifiedUser() && (resource.data.section in ['READ', 'MATH', 'THINK', 'WRIT'] || isAdmin());
      allow create: if isValidId(stimulusId) &&
        isAdmin() &&
        isValidBankStimulus(incoming()) &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(stimulusId) &&
        isAdmin() &&
        isValidBankStimulus(incoming()) &&
        incoming().updatedAt == request.time;
      allow delete: if isValidId(stimulusId) && isAdmin();
    }

    match /bank_questions/{questionId} {
      allow get: if isValidId(questionId) && isVerifiedUser();
      allow list: if isVerifiedUser() && (resource.data.section in ['READ', 'MATH', 'THINK', 'WRIT'] || isAdmin());
      allow create: if isValidId(questionId) &&
        isAdmin() &&
        isValidBankQuestion(incoming()) &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(questionId) &&
        isAdmin() &&
        isValidBankQuestion(incoming()) &&
        incoming().updatedAt == request.time;
      allow delete: if isValidId(questionId) && isAdmin();
    }

    match /import_batches/{batchId} {
      allow get: if isValidId(batchId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(batchId) &&
        isAdmin() &&
        isValidImportBatch(incoming()) &&
        incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    match /media_assets/{assetId} {
      allow get: if isValidId(assetId) && isVerifiedUser();
      allow list: if isAdmin();
      allow create: if isValidId(assetId) &&
        isAdmin() &&
        isValidMediaAsset(incoming()) &&
        incoming().createdAt == request.time;
      allow update: if isValidId(assetId) &&
        isAdmin() &&
        isValidMediaAsset(incoming());
      allow delete: if isValidId(assetId) && isAdmin();
    }

    match /bank_question_overrides/{questionId} {
      allow get: if isValidId(questionId) && isVerifiedUser();
      allow list: if isVerifiedUser() && (resource.data.qcStatus in ['draft', 'verified', 'active', 'quarantined', 'retired'] || isAdmin());
      allow create: if isValidId(questionId) &&
        isAdmin() &&
        isValidBankOverride(incoming()) &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(questionId) &&
        isAdmin() &&
        isValidBankOverride(incoming()) &&
        incoming().updatedAt == request.time;
      allow delete: if isValidId(questionId) && isAdmin();
    }

    // Question issue flags: verified user create (open), owner/admin read, sole-admin resolve
    match /question_flags/{flagId} {
      allow get: if isValidId(flagId) && isVerifiedUser() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isVerifiedUser() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isValidId(flagId) &&
        isVerifiedUser() &&
        isValidQuestionFlag(incoming()) &&
        incoming().flagId == flagId &&
        incoming().userId == request.auth.uid &&
        incoming().status == 'open' &&
        incoming().createdAt == request.time;
      allow update: if isValidId(flagId) &&
        isAdmin() &&
        isValidQuestionFlag(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().flagId == existing().flagId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'resolvedAtIso', 'updatedAt']);
      allow delete: if false;
    }
  }
}
