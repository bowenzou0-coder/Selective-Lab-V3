rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Zero-trust default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'bowenzou0@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Connection probe
    match /test/connection {
      allow get: if isSignedIn();
      allow write: if false;
    }

    // Server-managed admin allowlist (client SDK is read-only for own marker/admin check)
    match /admins/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }

    // Learner profile & strictly server-authored subcollections
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isVerifiedUser() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create, update, delete: if false;

      match /private/{docId} {
        allow get: if isValidId(userId) && docId == 'info' && (isOwner(userId) || isAdmin());
        allow list, create, update, delete: if false;
      }

      match /sessions/{sessionId} {
        allow get: if isValidId(userId) && isValidId(sessionId) && (isOwner(userId) || isAdmin());
        allow list: if isVerifiedUser() && (resource.data.userId == request.auth.uid || isAdmin());
        allow create, update, delete: if false;

        // Immutable session snapshots contain full question answer keys -> strictly server-only
        match /snapshots/{snapId} {
          allow read, write: if false;
        }
      }

      match /attempts/{attemptId} {
        allow get: if isValidId(userId) && isValidId(attemptId) && (isOwner(userId) || isAdmin());
        allow list: if isVerifiedUser() && (resource.data.userId == request.auth.uid || isAdmin());
        allow create, update, delete: if false;
      }

      match /skill_states/{skillDocId} {
        allow get: if isValidId(userId) && isValidId(skillDocId) && (isOwner(userId) || isAdmin());
        allow list: if isVerifiedUser() && (resource.data.userId == request.auth.uid || isAdmin());
        allow create, update, delete: if false;
      }

      match /question_memory/{familyDocId} {
        allow get: if isValidId(userId) && isValidId(familyDocId) && (isOwner(userId) || isAdmin());
        allow list: if isVerifiedUser() && (resource.data.userId == request.auth.uid || isAdmin());
        allow create, update, delete: if false;
      }

      match /question_evidence/{evidenceDocId} {
        allow get: if isValidId(userId) && isValidId(evidenceDocId) && (isOwner(userId) || isAdmin());
        allow list: if isVerifiedUser() && (resource.data.userId == request.auth.uid || isAdmin());
        allow create, update, delete: if false;
      }

      match /writing_submissions/{submissionId} {
        allow get: if isValidId(userId) && isValidId(submissionId) && (isOwner(userId) || isAdmin());
        allow list: if isVerifiedUser() && (resource.data.userId == request.auth.uid || isAdmin());
        allow create, update, delete: if false;
      }
    }

    // Configuration versions: read-only for verified users, server-only writes
    match /admin_configs/{configVersionId} {
      allow get: if isValidId(configVersionId) && isVerifiedUser();
      allow list: if isVerifiedUser();
      allow create, update, delete: if false;
    }

    // Authoritative question bank, stimuli, import batches, and media metadata -> server-only
    match /bank_stimuli/{stimulusId} {
      allow read, write: if false;
    }

    match /bank_questions/{questionId} {
      allow read, write: if false;
    }

    match /import_batches/{batchId} {
      allow read, write: if false;
    }

    match /media_assets/{assetId} {
      allow read, write: if false;
    }

    // Public-safe QC & visual overrides (legacy compatibility): read-only to verified users, server-only writes
    match /bank_question_overrides/{questionId} {
      allow get: if isValidId(questionId) && isVerifiedUser();
      allow list: if isVerifiedUser();
      allow create, update, delete: if false;
    }

    // Question issue flags: server-authored via /api/student/flags & /api/admin/flags
    match /question_flags/{flagId} {
      allow get: if isValidId(flagId) && isVerifiedUser() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isVerifiedUser() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create, update, delete: if false;
    }
  }
}
