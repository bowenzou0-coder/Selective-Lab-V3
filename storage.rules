rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // All media uploads and downloads are brokered and validated by the Express API server
    // via Firebase Admin SDK (/api/admin/media/upload and /api/media/:assetId).
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
